{
  "$id": "https://niklasrosenstein.github.io/gitopsctr/schemas/drivers/kubernetes-manifests/v1/unit.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "default": null
    },
    "delivery": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kubeContext": {
              "type": "string"
            },
            "mode": {
              "const": "direct"
            },
            "prune": {
              "default": false,
              "type": "boolean"
            },
            "wait": {
              "anyOf": [
                {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "condition": {
                        "type": "string"
                      },
                      "namespace": {
                        "type": "string"
                      },
                      "resource": {
                        "type": "string"
                      },
                      "timeoutSeconds": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "resource",
                      "namespace",
                      "condition",
                      "timeoutSeconds"
                    ],
                    "title": "ReadinessWait",
                    "type": "object"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "required": [
            "mode",
            "kubeContext"
          ],
          "title": "DirectDelivery",
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "external"
            },
            "observer": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "access": {
                      "const": "api"
                    },
                    "application": {
                      "type": "string"
                    },
                    "applicationNamespace": {
                      "type": "string"
                    },
                    "argocdContext": {
                      "type": "string"
                    },
                    "timeoutSeconds": {
                      "default": 600,
                      "type": "integer"
                    },
                    "type": {
                      "const": "argocd"
                    }
                  },
                  "required": [
                    "type",
                    "access",
                    "application",
                    "applicationNamespace",
                    "argocdContext"
                  ],
                  "title": "ArgoApiObserver",
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "access": {
                      "const": "kubernetes"
                    },
                    "application": {
                      "type": "string"
                    },
                    "applicationNamespace": {
                      "type": "string"
                    },
                    "kubeContext": {
                      "type": "string"
                    },
                    "timeoutSeconds": {
                      "default": 600,
                      "type": "integer"
                    },
                    "type": {
                      "const": "argocd"
                    }
                  },
                  "required": [
                    "type",
                    "access",
                    "application",
                    "applicationNamespace",
                    "kubeContext"
                  ],
                  "title": "ArgoKubernetesObserver",
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "required": [
            "mode"
          ],
          "title": "ExternalDelivery",
          "type": "object"
        }
      ]
    },
    "driver": {
      "const": "kubernetes-manifests"
    },
    "materialize": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "allowSecrets": {
              "default": false,
              "type": "boolean"
            },
            "namespace": {
              "type": "string"
            },
            "releaseName": {
              "type": "string"
            },
            "type": {
              "const": "helm"
            },
            "values": {
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            }
          },
          "required": [
            "type",
            "releaseName",
            "namespace",
            "values"
          ],
          "title": "HelmMaterialization",
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "allowSecrets": {
              "default": false,
              "type": "boolean"
            },
            "paths": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "type": {
              "const": "plain"
            }
          },
          "required": [
            "type"
          ],
          "title": "PlainMaterialization",
          "type": "object"
        }
      ]
    },
    "name": {
      "type": "string"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Input paths or glob patterns resolved relative to source.path."
        },
        "path": {
          "description": "Repository-relative path resolved from the root of the selected source revision.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "AuthoredSource",
      "type": "object"
    }
  },
  "required": [
    "name",
    "driver",
    "source",
    "materialize",
    "delivery"
  ],
  "title": "KubernetesUnit",
  "type": "object"
}
