{
  "$id": "https://niklasrosenstein.github.io/gitopsctr/schemas/drivers/kubernetes-manifests/v1/result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "applied": {
          "additionalProperties": false,
          "properties": {
            "inventory": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "apiVersion": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "namespace": {
                    "type": "string"
                  }
                },
                "required": [
                  "apiVersion",
                  "kind",
                  "namespace",
                  "name"
                ],
                "title": "ResourceIdentityModel",
                "type": "object"
              },
              "type": "array"
            },
            "manifestDigest": {
              "type": "string"
            }
          },
          "required": [
            "manifestDigest",
            "inventory"
          ],
          "title": "AppliedManifestsModel",
          "type": "object"
        }
      },
      "required": [
        "applied"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "observed": {
          "additionalProperties": false,
          "properties": {
            "application": {
              "type": "string"
            },
            "desiredRevision": {
              "type": "string"
            },
            "healthStatus": {
              "const": "Healthy"
            },
            "syncStatus": {
              "const": "Synced"
            }
          },
          "required": [
            "application",
            "desiredRevision",
            "syncStatus",
            "healthStatus"
          ],
          "title": "ObservedApplicationModel",
          "type": "object"
        }
      },
      "required": [
        "observed"
      ],
      "type": "object"
    }
  ],
  "title": "kubernetes-manifests result v1"
}
