                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "receipts": {
                  "anyOf": [
                    {
                      "additionalProperties": {
                        "type": "string"
                      },
                      "propertyNames": {
                        "type": "string"
                      },
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                }
              },
              "title": "ResolvedInputs",
              "type": "object"
            },
            {
              "type": "null"
            }
