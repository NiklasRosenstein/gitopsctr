          },
          "required": [
            "path"
          ],
          "title": "DesiredSource",
          "type": "object"
        },
        "terraform": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "backend": {
                  "anyOf": [
                    {
                      "additionalProperties": {
