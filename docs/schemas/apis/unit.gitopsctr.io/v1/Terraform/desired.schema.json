      "required": [
        "source"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "Terraform (unit.gitopsctr.io/v1)",
  "type": "object"
