                          "enum": [
                            "fromArtifact",
                            "fromEnvironment",
                            "fromPromotion",
                            "fromReceipt"
                          ]
                        }
                      },
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                }
