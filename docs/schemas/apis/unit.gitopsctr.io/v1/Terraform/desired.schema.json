                          {
                            "type": "integer"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          }
                        ]
                      },
                      "propertyNames": {
                        "type": "string"
                      },
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "checks": {
                  "anyOf": [
                    {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "path": {
                            "default": "",
                            "type": "string"
                          },
                          "type": {
                            "const": "http"
                          },
                          "urlOutput": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "urlOutput"
                        ],
                        "title": "TerraformHttpCheck",
                        "type": "object"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "observeOutputs": {
                  "anyOf": [
                    {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "variables": {
                  "anyOf": [
                    {
                      "additionalProperties": {
                        "$ref": "#/$defs/ResolvedJsonValue"
                      },
                      "propertyNames": {
