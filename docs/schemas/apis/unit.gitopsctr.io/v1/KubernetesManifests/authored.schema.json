{
  "$defs": {
    "TemplateValue": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "fromArtifact": {
              "additionalProperties": false,
              "properties": {
                "apiVersion": {
                  "pattern": "^[^/]+/[^/]+$",
                  "type": "string"
                },
                "kind": {
                  "pattern": "^[A-Z][A-Za-z0-9]*$",
                  "type": "string"
                },
                "name": {
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "type": "string"
                },
                "pointer": {
                  "default": "",
                  "pattern": "^(?:$|/(?:[^~]|~[01])*)$",
                  "type": "string"
                },
                "unit": {
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "type": "string"
                }
              },
              "required": [
                "unit",
                "name",
                "apiVersion",
                "kind"
              ],
              "type": "object"
            }
          },
          "required": [
            "fromArtifact"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "fromPromotion": {
              "additionalProperties": false,
              "properties": {
                "pointer": {
                  "default": "",
                  "pattern": "^(?:$|/(?:[^~]|~[01])*)$",
                  "type": "string"
                },
                "unit": {
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "type": "string"
                }
              },
              "required": [
                "unit"
              ],
              "type": "object"
            }
          },
          "required": [
            "fromPromotion"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "fromReceipt": {
              "additionalProperties": false,
              "properties": {
                "pointer": {
                  "default": "",
                  "pattern": "^(?:$|/(?:[^~]|~[01])*)$",
                  "type": "string"
                },
                "unit": {
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "type": "string"
                }
              },
              "required": [
                "unit"
              ],
              "type": "object"
            }
          },
          "required": [
            "fromReceipt"
          ],
          "type": "object"
        },
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/TemplateValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/TemplateValue"
          },
          "propertyNames": {
            "not": {
              "enum": [
                "fromArtifact",
                "fromPromotion",
                "fromReceipt"
              ]
            }
          },
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://niklasrosenstein.github.io/gitopsctr/schemas/apis/unit.gitopsctr.io/v1/KubernetesManifests/authored.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "apiVersion": {
      "const": "unit.gitopsctr.io/v1"
    },
    "kind": {
      "const": "KubernetesManifests"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "delivery": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "kubeContext": {
                  "type": "string"
                },
                "mode": {
                  "const": "direct"
                },
                "prune": {
                  "default": false,
                  "type": "boolean"
                },
                "wait": {
                  "anyOf": [
                    {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "condition": {
                            "type": "string"
                          },
                          "namespace": {
                            "type": "string"
                          },
                          "resource": {
                            "type": "string"
                          },
                          "timeoutSeconds": {
                            "type": "integer"
                          }
                        },
                        "required": [
                          "resource",
                          "namespace",
                          "condition",
                          "timeoutSeconds"
                        ],
                        "title": "ReadinessWait",
                        "type": "object"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                }
              },
              "required": [
                "mode",
                "kubeContext"
              ],
              "title": "DirectDelivery",
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "const": "external"
                },
                "observer": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "access": {
                          "const": "api"
                        },
                        "application": {
                          "type": "string"
                        },
                        "applicationNamespace": {
                          "type": "string"
                        },
                        "argocdContext": {
                          "type": "string"
                        },
                        "timeoutSeconds": {
                          "default": 600,
                          "type": "integer"
                        },
                        "type": {
                          "const": "argocd"
                        }
                      },
                      "required": [
                        "type",
                        "access",
                        "application",
                        "applicationNamespace",
                        "argocdContext"
                      ],
                      "title": "ArgoApiObserver",
                      "type": "object"
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "access": {
                          "const": "kubernetes"
                        },
                        "application": {
                          "type": "string"
                        },
                        "applicationNamespace": {
                          "type": "string"
                        },
                        "kubeContext": {
                          "type": "string"
                        },
                        "timeoutSeconds": {
                          "default": 600,
                          "type": "integer"
                        },
                        "type": {
                          "const": "argocd"
                        }
                      },
                      "required": [
                        "type",
                        "access",
                        "application",
                        "applicationNamespace",
                        "kubeContext"
                      ],
                      "title": "ArgoKubernetesObserver",
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                }
              },
              "required": [
                "mode"
              ],
              "title": "ExternalDelivery",
              "type": "object"
            }
          ]
        },
        "materialize": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "allowSecrets": {
                  "default": false,
                  "type": "boolean"
                },
                "namespace": {
                  "type": "string"
                },
                "releaseName": {
                  "type": "string"
                },
                "type": {
                  "const": "helm"
                },
                "values": {
                  "additionalProperties": {
                    "$ref": "#/$defs/TemplateValue"
                  },
                  "propertyNames": {
                    "not": {
                      "enum": [
                        "fromArtifact",
                        "fromPromotion",
                        "fromReceipt"
                      ]
                    }
                  },
                  "type": "object"
                }
              },
              "required": [
                "type",
                "releaseName",
                "namespace",
                "values"
              ],
              "title": "AuthoredHelmMaterialization",
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "allowSecrets": {
                  "default": false,
                  "type": "boolean"
                },
                "paths": {
                  "anyOf": [
                    {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "type": {
                  "const": "plain"
                }
              },
              "required": [
                "type"
              ],
              "title": "PlainMaterialization",
              "type": "object"
            }
          ]
        },
        "source": {
          "additionalProperties": false,
          "properties": {
            "inputs": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Input paths or glob patterns resolved relative to source.path."
            },
            "path": {
              "description": "Repository-relative path resolved from the root of the selected source revision.",
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "title": "AuthoredSource",
          "type": "object"
        }
      },
      "required": [
        "source",
        "materialize",
        "delivery"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "KubernetesManifests (unit.gitopsctr.io/v1)",
  "type": "object"
}
