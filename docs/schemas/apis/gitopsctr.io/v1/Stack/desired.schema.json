{
  "$id": "https://niklasrosenstein.github.io/gitopsctr/schemas/apis/gitopsctr.io/v1/Stack/desired.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "apiVersion": {
      "const": "gitopsctr.io/v1"
    },
    "kind": {
      "const": "Stack"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "lifecycle": {
          "additionalProperties": false,
          "oneOf": [
            {
              "not": {
                "required": [
                  "owner"
                ]
              },
              "required": [
                "management"
              ]
            },
            {
              "not": {
                "required": [
                  "management"
                ]
              },
              "required": [
                "owner"
              ]
            }
          ],
          "properties": {
            "management": {
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": [
                    "sourceTracked",
                    "direct"
                  ]
                }
              },
              "required": [
                "mode"
              ],
              "title": "LifecycleManagement",
              "type": "object"
            },
            "owner": {
              "additionalProperties": false,
              "properties": {
                "apiVersion": {
                  "minLength": 1,
                  "type": "string"
                },
                "kind": {
                  "minLength": 1,
                  "type": "string"
                },
                "name": {
                  "minLength": 1,
                  "type": "string"
                },
                "uid": {
                  "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                  "type": "string"
                }
              },
              "required": [
                "apiVersion",
                "kind",
                "name",
                "uid"
              ],
              "title": "DesiredOwnerReference",
              "type": "object"
            }
          },
          "title": "DesiredLifecycle",
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "uid": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uid",
        "lifecycle"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "parameters": {
          "type": "object"
        },
        "template": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "type": "string"
        }
      },
      "required": [
        "template",
        "parameters"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "Stack (gitopsctr.io/v1)",
  "type": "object"
}
