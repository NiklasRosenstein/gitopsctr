                "name"
              ],
              "type": "object"
            }
          },
          "required": [
            "fromParameter"
          ],
          "type": "object"
        },
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
