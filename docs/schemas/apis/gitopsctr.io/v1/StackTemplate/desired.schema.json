              }
            },
            "required": [
              "apiVersion",
              "kind",
              "name",
              "uid"
            ],
            "title": "DesiredOwnerReference",
            "type": "object"
          },
          "maxItems": 1,
          "minItems": 1,
          "type": "array"
        },
        "uid": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uid"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "parameters": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                "type": "string"
              },
              "type": {
                "enum": [
                  "string",
                  "integer",
                  "number",
                  "boolean",
                  "object",
                  "array"
                ]
              }
            },
            "required": [
              "name",
              "type"
            ],
            "title": "ParameterDeclaration",
            "type": "object"
          },
          "type": "array"
        },
        "requestedSource": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "fromResource": {
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "anyOf": [
                            {
                              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "default": null
                        },
                        "uid": {
                          "anyOf": [
                            {
                              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "default": null
                        }
                      },
                      "title": "StackTemplateResourceReference",
                      "type": "object"
                    }
                  },
                  "title": "StackTemplateFromResource",
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "fromGit": {
                      "additionalProperties": false,
                      "properties": {
                        "commit": {
                          "anyOf": [
                            {
                              "pattern": "^[0-9a-f]{40}$",
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "default": null
                        },
                        "path": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "default": null
                        },
                        "ref": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "default": null
                        },
                        "remote": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "default": null
                        }
                      },
                      "title": "GitSourceRequest",
                      "type": "object"
                    }
                  },
                  "required": [
                    "fromGit"
                  ],
                  "title": "StackTemplateFromGit",
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "fromPromotion": {
                      "additionalProperties": false,
                      "properties": {
                        "stack": {
                          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                          "type": "string"
                        }
                      },
                      "required": [
                        "stack"
                      ],
                      "title": "StackTemplatePromotionReference",
                      "type": "object"
                    }
                  },
                  "required": [
                    "fromPromotion"
                  ],
                  "title": "StackTemplateFromPromotion",
                  "type": "object"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resolvedSource": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "fromGit": {
                  "additionalProperties": false,
                  "properties": {
                    "commit": {
                      "pattern": "^[0-9a-f]{40}$",
                      "type": "string"
                    },
                    "digest": {
                      "pattern": "^[0-9a-f]{64}$",
                      "type": "string"
                    },
                    "path": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null
                    },
                    "ref": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null
                    },
                    "remote": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null
                    },
                    "resourcePath": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "commit",
                    "resourcePath",
                    "digest"
                  ],
                  "title": "ResolvedGitSource",
                  "type": "object"
                }
              },
              "required": [
                "fromGit"
              ],
              "title": "ResolvedStackTemplateSource",
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unitTemplates": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "apiVersion": {
                "pattern": "^[^/]+/[^/]+$",
                "type": "string"
              },
              "dependsOn": {
                "items": {
                  "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                  "type": "string"
                },
                "type": "array"
              },
              "kind": {
                "pattern": "^[A-Z][A-Za-z0-9]*$",
                "type": "string"
              },
              "spec": {
                "additionalProperties": {
                  "$ref": "#/$defs/TemplateValue"
                },
                "propertyNames": {
                  "not": {
                    "enum": [
                      "fromArtifact",
                      "fromEnvironment",
                      "fromParameter",
                      "fromPromotion",
                      "fromReceipt"
                    ]
                  }
                },
                "type": "object"
              }
            },
            "required": [
              "apiVersion",
              "kind",
              "spec"
            ],
            "title": "StackTemplateUnitTemplate",
            "type": "object"
          },
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
            "type": "string"
          },
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "StackTemplate (gitopsctr.io/v1)",
  "type": "object"
