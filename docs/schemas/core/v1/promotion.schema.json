{
  "$id": "https://niklasrosenstein.github.io/gitopsctr/schemas/core/v1/promotion.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "default": null
    },
    "schema": {
      "const": 1
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "desiredRef": {
          "type": "string"
        },
        "desiredRevision": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "observedRef": {
          "type": "string"
        },
        "observedRevision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "environment",
        "desiredRef",
        "desiredRevision",
        "observedRef",
        "observedRevision"
      ],
      "title": "PromotionSource",
      "type": "object"
    },
    "specificationRevision": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "source",
    "specificationRevision"
  ],
  "title": "PromotionDocument",
  "type": "object"
}
