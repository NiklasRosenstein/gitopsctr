{
  "schema": 1,
  "name": "web",
  "driver": "kubernetes-manifests",
  "source": {
    "path": "charts/web",
    "inputs": ["**/*"]
  },
  "materialize": {
    "type": "helm",
    "releaseName": "web",
    "namespace": "default",
    "values": {
      "message": "rendered and reconciled"
    },
    "allowSecrets": false
  },
  "delivery": {
    "mode": "direct",
    "kubeContext": "kind-gitopsctr-kubernetes-demo",
    "prune": false,
    "wait": []
  }
}
