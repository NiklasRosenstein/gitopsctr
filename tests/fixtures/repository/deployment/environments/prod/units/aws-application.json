  "apiVersion": "unit.gitopsctr.io/v1",
  "kind": "Terraform",
  "metadata": {
    "name": "aws-application"
  },
  "spec": {
    "source": {
      "path": "infrastructure"
    },
    "terraform": {
      "backend": {
        "key": "example/prod.tfstate"
      },
      "checks": [],
      "observeOutputs": [],
      "variables": {
        "environment": "prod"
      }
    }
  }
}
