{
  "$schema": "https://niklasrosenstein.github.io/gitopsctr/schemas/drivers/oci-images/v2/unit.schema.json",
  "schema": 1,
  "name": "application-images",
  "driver": "oci-images",
  "source": {
    "path": ".",
    "inputs": ["pyproject.toml"]
  },
  "build": {
    "dockerfile": "Dockerfile",
    "platform": "linux/amd64"
  },
  "publish": {
    "repositories": {
      "application": "registry.example/example/application"
    }
  },
  "artifacts": ["containers.json"]
}
